<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.0</version>
    <relativePath/>
  </parent>

  <groupId>io.bankplatform</groupId>
  <artifactId>bank-platform</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>bank-platform</name>
  <description>Monorepo core banking: platform-libs (javalibs), bank-common, 5 service nghiệp vụ + gateway.</description>

  <properties>
    <java.version>21</java.version>
    <maven.compiler.release>${java.version}</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!--
      springdoc KHÔNG nằm trong spring-boot-dependencies (đã kiểm:
      grep -c springdoc spring-boot-dependencies-4.1.0.pom -> 0), nên phải tự
      ghim version. 3.1.0 là bản platform-libs cũ dùng với Boot 4.1 và đã có
      trong ~/.m2. Nâng version thì kiểm lại Swagger UI mở được.
    -->
    <springdoc.version>3.1.0</springdoc.version>
    <javalibs.version>2.0.0-SNAPSHOT</javalibs.version>
  </properties>

  <!--
    platform-libs đã bị gỡ khỏi repo (2026-09-01) — chủ dự án tự viết lại phần
    hạ tầng để hiểu bản chất. Muốn tham khảo bản javalibs cũ:
      git show b095cd5:platform-libs/<đường-dẫn>
  -->
  <modules>
    <module>services/bank-common</module>
    <module>services/auth-service</module>
    <module>services/product-service</module>
    <module>services/notification-service</module>
    <module>services/core-banking-service</module>
    <module>services/customer-service</module>
    <module>services/gateway-service</module>
  </modules>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springdoc</groupId>
        <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        <version>${springdoc.version}</version>
      </dependency>
      <dependency>
        <groupId>io.javalibs</groupId>
        <artifactId>javalibs-dependencies</artifactId>
        <version>${javalibs.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>io.bankplatform</groupId>
        <artifactId>bank-common</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-maven-plugin</artifactId>
          <executions>
            <!--
              Sinh build-info.properties để BuildProperties tồn tại lúc runtime —
              nguồn của trường "version" trong API /info. Đặt ở pluginManagement
              nên áp cho MỌI service (chúng đều khai plugin này), một chỗ duy nhất.
              platform-libs không nhận pom này làm parent nên không bị ảnh hưởng.
            -->
            <execution>
              <goals>
                <goal>build-info</goal>
              </goals>
            </execution>
          </executions>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>

  <profiles>
    <!--
      platform-libs là javalibs nguyên vẹn: nó KHÔNG khai POM này làm <parent>
      (javalibs-root tự là root và quyết định D2 cấm sửa nó). Maven cho phép
      điều đó: <modules> quyết định thứ tự build, <parent> quyết định kế thừa —
      hai chuyện độc lập.

      Vì sao là profile "thêm vào" chứ không phải profile "bỏ ra": Maven chỉ
      cho profile THÊM module, không cho BỚT. Muốn build nhanh sau khi javalibs
      đã nằm trong local repo:  mvn -P'!with-libs' clean install
    -->
    <profile>
      <id>with-libs</id>
      <activation>
        <activeByDefault>true</activeByDefault>
      </activation>
      <modules>
        <module>platform-libs</module>
      </modules>
    </profile>
  </profiles>
</project>
