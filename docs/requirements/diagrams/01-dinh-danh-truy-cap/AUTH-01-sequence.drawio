          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="550" y="460"/><mxPoint x="550" y="490"/></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="m7" value="INSERT users (status = ACTIVE) + user_roles (CUSTOMER)" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.7778;entryX=0;entryY=0.0;" edge="1" parent="1" source="act2" target="act1">
          <mxGeometry relative="1" as="geometry"/>
