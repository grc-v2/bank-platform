          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="note5" value="E3 — username trùng: trả lỗi chung&#xa;'thông tin đăng ký không hợp lệ'&#xa;(chống dò tài khoản)" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="510" y="380" width="140" height="40" as="geometry"/>
        </mxCell>
