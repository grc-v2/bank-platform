        <mxCell id="m0" value="POST /auth/change-password (mật khẩu cũ + mới, Bearer token)" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=0.5;exitY=0.1233;entryX=0;entryY=0.0;" edge="1" parent="1" source="user" target="act3">
