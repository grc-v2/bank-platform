        </mxCell>
        <mxCell id="kafka" value="Kafka" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=40;" vertex="1" parent="1">
          <mxGeometry x="640" y="40" width="100" height="780" as="geometry"/>
        </mxCell>
        <mxCell id="act0" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;fillColor=#ffffff;" vertex="1" parent="db">
          <mxGeometry x="45" y="140" width="10" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="act1" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;fillColor=#ffffff;" vertex="1" parent="prod">
          <mxGeometry x="45" y="90" width="10" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="act2" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;fillColor=#ffffff;" vertex="1" parent="db">
          <mxGeometry x="45" y="590" width="10" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="act3" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;fillColor=#ffffff;" vertex="1" parent="prod">
          <mxGeometry x="45" y="540" width="10" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="act4" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;fillColor=#ffffff;" vertex="1" parent="core">
          <mxGeometry x="45" y="420" width="10" height="320" as="geometry"/>
        </mxCell>
        <mxCell id="m0" value="GET cấu hình sản phẩm X tại ngày D&#xa;(mặc định D = hôm nay)" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=0.5;exitY=0.1154;entryX=0;entryY=0.0;" edge="1" parent="1" source="core" target="act1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m1" value="mỗi bảng giá trị: lấy dòng có&#xa;effective_from &lt;= D &lt; effective_to" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.3333;entryX=0;entryY=0.0;" edge="1" parent="1" source="act1" target="act0">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m2" value="lãi suất, phí theo sự kiện, hạn mức theo kênh,&#xa;GL mapping, eligibility hiệu lực tại D" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;strokeColor=#999999;fontColor=#999999;exitX=0;exitY=1.0;entryX=1;entryY=0.6667;" edge="1" parent="1" source="act0" target="act1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m3" value="cấu hình sản phẩm X tại ngày D" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;strokeColor=#999999;fontColor=#999999;exitX=0;exitY=1.0;entryX=0.5;entryY=0.3077;" edge="1" parent="1" source="act1" target="core">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m4" value="cache kết quả (TTL + serve-stale — chịu được&#xa;product-service chết ngắn hạn)" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=0.5;exitY=0.3718;entryX=0.5;entryY=0.4103;" edge="1" parent="1" source="core" target="core">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="150" y="330"/><mxPoint x="150" y="360"/></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="note5" value="Hợp đồng chính (BR-PROD-07-1): mọi tính toán tiền&#xa;(phí, lãi, hạn mức) hỏi 'tại ngày D' theo value_date,&#xa;không hỏi 'hiện giờ'. Catalog công khai chỉ lộ ACTIVE" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="110" y="380" width="140" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="m6" value="product.activated.v1 / product.retired.v1" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;exitX=0.5;exitY=0.5385;entryX=1;entryY=0.0;" edge="1" parent="1" source="kafka" target="act4">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m7" value="vô hiệu cache catalog" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.1562;entryX=1;entryY=0.25;" edge="1" parent="1" source="act4" target="act4">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="150" y="510"/><mxPoint x="150" y="540"/></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="m8" value="GET lại cấu hình (lần gọi kế tiếp)" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.375;entryX=0;entryY=0.0;" edge="1" parent="1" source="act4" target="act3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m9" value="SELECT dòng hiệu lực tại ngày hỏi" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.3333;entryX=0;entryY=0.0;" edge="1" parent="1" source="act3" target="act2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m10" value="cấu hình mới nhất theo ngày hiệu lực" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;strokeColor=#999999;fontColor=#999999;exitX=0;exitY=1.0;entryX=1;entryY=0.6667;" edge="1" parent="1" source="act2" target="act3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m11" value="cấu hình cập nhật — nạp lại cache" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;strokeColor=#999999;fontColor=#999999;exitX=0;exitY=1.0;entryX=1;entryY=0.8438;" edge="1" parent="1" source="act3" target="act4">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
