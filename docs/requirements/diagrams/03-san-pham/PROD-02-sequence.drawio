          <mxGeometry x="45" y="90" width="10" height="730" as="geometry"/>
        </mxCell>
        <mxCell id="act5" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;fillColor=#ffffff;" vertex="1" parent="db">
          <mxGeometry x="45" y="720" width="10" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="m0" value="GET /products/{id}/interest-rates" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=0.5;exitY=0.0989;entryX=0;entryY=0.0;" edge="1" parent="1" source="admin" target="act4">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m1" value="chuyển tiếp (vai trò ADMIN)" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.0685;entryX=0;entryY=0.0;" edge="1" parent="1" source="act4" target="act1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m2" value="SELECT các dòng hiệu lực hôm nay" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.3333;entryX=0;entryY=0.0;" edge="1" parent="1" source="act1" target="act0">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m3" value="biểu lãi hiện hành" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;strokeColor=#999999;fontColor=#999999;exitX=0;exitY=1.0;entryX=1;entryY=0.6667;" edge="1" parent="1" source="act0" target="act1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m4" value="biểu lãi hiện hành (bậc / kỳ hạn)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;strokeColor=#999999;fontColor=#999999;exitX=0;exitY=1.0;entryX=0.5;entryY=0.3187;" edge="1" parent="1" source="act1" target="admin">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m5" value="PUT biểu mới: bậc hoặc kỳ hạn + lãi suất&#xa;+ effective_from (thường là ngày mai)" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=0.5;exitY=0.3736;entryX=0;entryY=0.3425;" edge="1" parent="1" source="admin" target="act4">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m6" value="chuyển tiếp" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.411;entryX=0;entryY=0.0;" edge="1" parent="1" source="act4" target="act3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m7" value="validate: lãi suất thập phân nhỏ hơn 1,&#xa;effective_from không lùi quá khứ" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.1316;entryX=1;entryY=0.2105;" edge="1" parent="1" source="act3" target="act3">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="550" y="480"/><mxPoint x="550" y="510"/></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="m8" value="BEGIN — bước a: ĐÓNG dòng hiện hành bị thay&#xa;(effective_to = effective_from mới)" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.3158;entryX=0;entryY=0.0;" edge="1" parent="1" source="act3" target="act2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m9" value="bước b: CHÈN các dòng mới — COMMIT" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.4474;entryX=0;entryY=0.5;" edge="1" parent="1" source="act3" target="act2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m10" value="OK (hoặc lỗi ex_rate_overlap nếu chồng lấn)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;strokeColor=#999999;fontColor=#999999;exitX=0;exitY=1.0;entryX=1;entryY=0.5789;" edge="1" parent="1" source="act2" target="act3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="note11" value="Bất biến: EXCLUDE ex_rate_overlap — tại mọi&#xa;(sản phẩm, số dư, kỳ hạn, ngày) có ĐÚNG MỘT lãi suất.&#xa;Đóng-trước-chèn-sau trong MỘT transaction (BR-G5)" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="710" y="680" width="140" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="m12" value="ghi audit thay đổi biểu" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.8684;entryX=0;entryY=0.0;" edge="1" parent="1" source="act3" target="act5">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m13" value="200 — biểu mới hiệu lực từ ngày đặt, không cần deploy" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;strokeColor=#999999;fontColor=#999999;exitX=0;exitY=1.0;entryX=1;entryY=0.9315;" edge="1" parent="1" source="act3" target="act4">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m14" value="200 OK" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;strokeColor=#999999;fontColor=#999999;exitX=0;exitY=1.0;entryX=0.5;entryY=0.9011;" edge="1" parent="1" source="act4" target="admin">
          <mxGeometry relative="1" as="geometry"/>
