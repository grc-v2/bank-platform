<mxfile>
  <diagram id="seqlayout" name="PROD-03 — Quản lý biểu phí">
    <mxGraphModel dx="800" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="admin" value="Admin" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=40;participant=umlActor;verticalAlign=bottom;spacingBottom=-14;labelBackgroundColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="100" height="720" as="geometry"/>
        </mxCell>
        <mxCell id="gw" value="Gateway" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=40;" vertex="1" parent="1">
          <mxGeometry x="240" y="40" width="100" height="720" as="geometry"/>
        </mxCell>
        <mxCell id="prod" value="Product Service" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=40;" vertex="1" parent="1">
          <mxGeometry x="440" y="40" width="100" height="720" as="geometry"/>
        </mxCell>
        <mxCell id="db" value="DB (product)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=40;" vertex="1" parent="1">
          <mxGeometry x="640" y="40" width="100" height="720" as="geometry"/>
        </mxCell>
        <mxCell id="act0" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;fillColor=#ffffff;" vertex="1" parent="db">
          <mxGeometry x="45" y="320" width="10" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="act1" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;fillColor=#ffffff;" vertex="1" parent="prod">
          <mxGeometry x="45" y="140" width="10" height="440" as="geometry"/>
        </mxCell>
        <mxCell id="act2" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;fillColor=#ffffff;" vertex="1" parent="gw">
          <mxGeometry x="45" y="90" width="10" height="540" as="geometry"/>
        </mxCell>
        <mxCell id="act3" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;fillColor=#ffffff;" vertex="1" parent="db">
          <mxGeometry x="45" y="530" width="10" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="m0" value="PUT /products/{id}/fees (fee_code, charge_event,&#xa;FLAT hoặc PERCENT, min/max, effective_from)" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=0.5;exitY=0.125;entryX=0;entryY=0.0;" edge="1" parent="1" source="admin" target="act2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m1" value="chuyển tiếp (vai trò ADMIN)" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.0926;entryX=0;entryY=0.0;" edge="1" parent="1" source="act2" target="act1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m2" value="validate ck_fee_shape (FLAT chỉ amount, PERCENT chỉ percent),&#xa;ck_fee_bounds, ck_fee_period" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.1136;entryX=1;entryY=0.1818;" edge="1" parent="1" source="act1" target="act1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="550" y="230"/><mxPoint x="550" y="260"/></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="note3" value="Phí bậc thang (TIERED) không nhét vào kiểu hiện có —&#xa;cần bảng product_fee_tiers, coi là thay đổi thiết kế" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="510" y="280" width="140" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="m4" value="BEGIN — bước a: ĐÓNG dòng hiện hành cùng&#xa;(product, fee_code): effective_to = effective_from mới" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.4091;entryX=0;entryY=0.0;" edge="1" parent="1" source="act1" target="act0">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m5" value="bước b: CHÈN dòng phí mới — COMMIT" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.5227;entryX=0;entryY=0.5;" edge="1" parent="1" source="act1" target="act0">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m6" value="OK (hoặc lỗi ex_fee_overlap nếu chồng hiệu lực)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;strokeColor=#999999;fontColor=#999999;exitX=0;exitY=1.0;entryX=1;entryY=0.6364;" edge="1" parent="1" source="act0" target="act1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="note7" value="Bất biến: ex_fee_overlap — không chồng hiệu lực cùng&#xa;(product, fee_code). Đóng-trước-chèn-sau trong MỘT transaction (BR-G5).&#xa;Phí = 0 là dòng hợp lệ: miễn phí có chủ đích, vẫn ghi vết" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="710" y="490" width="140" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="m8" value="ghi audit thay đổi biểu phí" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.8864;entryX=0;entryY=0.0;" edge="1" parent="1" source="act1" target="act3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m9" value="200 — biểu phí hiệu lực từ ngày đặt,&#xa;FEE-01/02 đọc bảng này khi tính phí" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;strokeColor=#999999;fontColor=#999999;exitX=0;exitY=1.0;entryX=1;entryY=0.9074;" edge="1" parent="1" source="act1" target="act2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m10" value="200 OK" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;strokeColor=#999999;fontColor=#999999;exitX=0;exitY=1.0;entryX=0.5;entryY=0.875;" edge="1" parent="1" source="act2" target="admin">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
