          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="note7" value="available = ledger − hold.&#xa;Số dư đọc cột lưu sẵn (quyết định DB4) —&#xa;không bao giờ SUM sổ cái lúc đọc" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
