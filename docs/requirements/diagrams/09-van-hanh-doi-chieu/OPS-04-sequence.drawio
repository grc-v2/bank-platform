        <mxCell id="m0" value="EOD bước 9 (tuần cuối tháng): kiểm partition journal_lines tháng M+1" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=0.5;exitY=0.1125;entryX=0;entryY=0.0;" edge="1" parent="1" source="job" target="act0">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m1" value="chưa tồn tại" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;strokeColor=#999999;fontColor=#999999;exitX=0;exitY=1.0;entryX=0.5;entryY=0.175;" edge="1" parent="1" source="act0" target="job">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m2" value="CREATE TABLE journal_lines_yyyy_mm PARTITION OF ... FOR VALUES FROM ... TO ..." style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=0.5;exitY=0.2375;entryX=0;entryY=0.0;" edge="1" parent="1" source="job" target="act1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m3" value="đã tạo partition tháng M+1" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;strokeColor=#999999;fontColor=#999999;exitX=0;exitY=1.0;entryX=0.5;entryY=0.3;" edge="1" parent="1" source="act1" target="job">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m4" value="kiểm partition DEFAULT có dòng nào không" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=0.5;exitY=0.3625;entryX=0;entryY=0.0;" edge="1" parent="1" source="job" target="act2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m5" value="DEFAULT có N dòng (N &gt; 0)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;strokeColor=#999999;fontColor=#999999;exitX=0;exitY=1.0;entryX=0.5;entryY=0.425;" edge="1" parent="1" source="act2" target="job">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m6" value="cảnh báo: DEFAULT có dữ liệu — sự cố mức trung bình, xử lý trong tuần (BR-OPS-04-2)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;exitX=0.5;exitY=0.4875;entryX=0;entryY=0.0;" edge="1" parent="1" source="job" target="act4">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m7" value="yêu cầu tách dữ liệu ra partition đúng (thao tác có kế hoạch, không tự động)" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.1351;entryX=0;entryY=0.0;" edge="1" parent="1" source="act4" target="act5">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m8" value="tách dữ liệu khỏi DEFAULT về partition đúng" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=0;exitY=0.1562;entryX=1;entryY=0.0;" edge="1" parent="1" source="act5" target="act3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="note9" value="Lưu trữ dữ liệu cũ (A1): quyết định DROP là của DBA + Kế toán trưởng,&#xa;có biên bản, niên hạn tuân BR-OPS-02-3" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="710" y="560" width="140" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="m10" value="export partition quá niên hạn ra lưu trữ lạnh rồi DROP (thay cho DELETE hàng triệu dòng)" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=0;exitY=0.5;entryX=1;entryY=0.6875;" edge="1" parent="1" source="act5" target="act3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m11" value="OK — đã giải phóng partition cũ" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;strokeColor=#999999;fontColor=#999999;exitX=1;exitY=1.0;entryX=0;entryY=0.6562;" edge="1" parent="1" source="act3" target="act5">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="note12" value="BR-OPS-04-1: luôn tồn tại partition cho tháng hiện tại + tháng kế tiếp" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="310" y="720" width="140" height="40" as="geometry"/>
        </mxCell>
      </root>
