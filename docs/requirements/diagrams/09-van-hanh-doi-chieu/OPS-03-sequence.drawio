        <mxCell id="note0" value="23:30 giờ hệ thống (hoặc Ops chạy tay) — ngày nghiệp vụ D.&#xa;Thứ tự bước cố định, bước sau chỉ chạy khi bước trước xong (BR-OPS-03-1)" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
