        <mxCell id="m2" value="dựng bản ghi audit (ai / làm gì / lên cái gì / khi nào / detail JSONB), lược bỏ dữ liệu nhạy cảm dạng thô" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.3125;entryX=1;entryY=0.4062;" edge="1" parent="1" source="act1" target="act1">
