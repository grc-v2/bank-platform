        <mxCell id="m0" value="thao tác ghi nghiệp vụ (phê duyệt, bút toán thủ công...)" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=0.5;exitY=0.1184;entryX=0;entryY=0.0;" edge="1" parent="1" source="staff" target="act1">
