        <mxCell id="m0" value="chạy đối chiếu ngày D (trong lịch EOD, sau GL-04)" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=0.5;exitY=0.1059;entryX=0;entryY=0.0;" edge="1" parent="1" source="job" target="act3">
