        <mxCell id="act4" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;fillColor=#ffffff;" vertex="1" parent="db">
          <mxGeometry x="45" y="630" width="10" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="m0" value="yêu cầu đảo bút toán X kèm lý do (thủ công có phê duyệt)" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=0.5;exitY=0.1169;entryX=0;entryY=0.0;" edge="1" parent="1" source="kt" target="act3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="note1" value="Saga TRF-05/06 cũng gọi cùng đường này&#xa;tự động, ghi rõ nguồn (BR-GL-03-3)" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="350" y="160" width="180" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="m2" value="đọc trọn các dòng của X" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.1864;entryX=0;entryY=0.0;" edge="1" parent="1" source="act3" target="act0">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m3" value="header + journal_lines gốc (X chưa bị đảo)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;strokeColor=#999999;fontColor=#999999;exitX=0;exitY=1.0;entryX=1;entryY=0.2712;" edge="1" parent="1" source="act0" target="act3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m4" value="dựng lệnh mới: giữ nguyên account/GL/số tiền, đảo chiều Nợ↔Có, booking_date = kỳ hiện tại" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.3559;entryX=1;entryY=0.4068;" edge="1" parent="1" source="act3" target="act3">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="390" y="340"/><mxPoint x="390" y="370"/></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="m5" value="gọi GL-02: transaction_type = REVERSAL, reversal_of_entry_id = X" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.4746;entryX=0;entryY=0.0;" edge="1" parent="1" source="act3" target="act2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m6" value="ghi header + dòng đảo + cập nhật số dư (MỘT transaction)" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.2381;entryX=0;entryY=0.0;" edge="1" parent="1" source="act2" target="act1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="note7" value="Một bút toán chỉ được đảo MỘT lần (uq_journal_one_reversal),&#xa;REVERSAL bắt buộc trỏ gốc (ck_journal_reversal).&#xa;X đã bị đảo → unique violation, rollback — chống hoàn hai lần.&#xa;Không có đảo từng phần: hoàn một phần dùng ADJUSTMENT." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="830" y="490" width="180" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="m8" value="OK — bút toán đảo Y đã cân" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;strokeColor=#999999;fontColor=#999999;exitX=0;exitY=1.0;entryX=1;entryY=0.7619;" edge="1" parent="1" source="act1" target="act2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m9" value="entry_id = Y" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;strokeColor=#999999;fontColor=#999999;exitX=0;exitY=1.0;entryX=1;entryY=0.8305;" edge="1" parent="1" source="act2" target="act3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m10" value="ghi audit (lý do, người/tiến trình yêu cầu)" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.9153;entryX=0;entryY=0.0;" edge="1" parent="1" source="act3" target="act4">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m11" value="kết quả: X đã đảo bằng Y (đảo Y để khôi phục vẫn hợp lệ)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;strokeColor=#999999;fontColor=#999999;exitX=0;exitY=1.0;entryX=0.5;entryY=0.8831;" edge="1" parent="1" source="act3" target="kt">
          <mxGeometry relative="1" as="geometry"/>
