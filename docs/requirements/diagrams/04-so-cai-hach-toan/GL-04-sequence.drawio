          </mxGeometry>
        </mxCell>
        <mxCell id="m6" value="INSERT account_balance_snapshots (PK: account_id + as_of_date)" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.5079;entryX=0;entryY=0.0;" edge="1" parent="1" source="act4" target="act2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="note7" value="Snapshot BẤT BIẾN sau khi ghi (BR-GL-04-1).&#xa;Chạy lại ngày D là idempotent: đã có thì bỏ qua,&#xa;số khác số vừa tính → KHÔNG ghi đè, cảnh báo đối chiếu (E3)." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="510" y="480" width="140" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="m8" value="OK" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;strokeColor=#999999;fontColor=#999999;exitX=0;exitY=1.0;entryX=1;entryY=0.6825;" edge="1" parent="1" source="act2" target="act4">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m9" value="so closing với accounts.ledger_balance hiện hành" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.7619;entryX=0;entryY=0.0;" edge="1" parent="1" source="act4" target="act3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m10" value="danh sách tài khoản lệch (nếu có)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;strokeColor=#999999;fontColor=#999999;exitX=0;exitY=1.0;entryX=1;entryY=0.8413;" edge="1" parent="1" source="act3" target="act4">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m11" value="phát cờ lệch / cảnh báo đối chiếu cho GL-05" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;exitX=1;exitY=0.9206;entryX=0;entryY=0.0;" edge="1" parent="1" source="act4" target="act5">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m12" value="hoàn tất snapshot ngày D — mới được mở ngày D+1 (BR-GL-04-3)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;strokeColor=#999999;fontColor=#999999;exitX=0;exitY=1.0;entryX=0.5;entryY=0.8889;" edge="1" parent="1" source="act4" target="job">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
      </root>
