        </mxCell>
        <mxCell id="m0" value="OPS-03: chạy snapshot ngày D (sau giờ khóa sổ)" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=0.5;exitY=0.1111;entryX=0;entryY=0.0;" edge="1" parent="1" source="job" target="act4">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m1" value="đọc closing snapshot D-1 của từng tài khoản (opening, hoặc 0 nếu chưa có)" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.0794;entryX=0;entryY=0.0;" edge="1" parent="1" source="act4" target="act0">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m2" value="opening từng tài khoản" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;strokeColor=#999999;fontColor=#999999;exitX=0;exitY=1.0;entryX=1;entryY=0.1587;" edge="1" parent="1" source="act0" target="act4">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m3" value="SUM Nợ / Có journal_lines có booking_date trong ngày D" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.2381;entryX=0;entryY=0.0;" edge="1" parent="1" source="act4" target="act1">
