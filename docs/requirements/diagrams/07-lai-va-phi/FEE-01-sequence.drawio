        <mxCell id="act3" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;fillColor=#ffffff;" vertex="1" parent="kafka">
          <mxGeometry x="45" y="470" width="10" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="m0" value="giao dịch có phí (vd chuyển tiền TRF-01/02, yêu cầu sao kê)" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=0.5;exitY=0.1475;entryX=0;entryY=0.0;" edge="1" parent="1" source="kh" target="act2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m1" value="hỏi biểu phí: (product, charge_event, ngày sự kiện)" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.1163;entryX=0;entryY=0.0;" edge="1" parent="1" source="act2" target="act0">
