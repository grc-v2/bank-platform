        <mxCell id="m7" value="outbox fee.charged.v1 (khi phí &gt; 0)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;exitX=1;exitY=0.8837;entryX=0;entryY=0.0;" edge="1" parent="1" source="act2" target="act3">
          <mxGeometry relative="1" as="geometry"/>
