        </mxCell>
        <mxCell id="m2" value="các dòng phí áp dụng (FLAT / PERCENT, min-max)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;strokeColor=#999999;fontColor=#999999;exitX=0;exitY=1.0;entryX=1;entryY=0.2326;" edge="1" parent="1" source="act0" target="act2">
          <mxGeometry relative="1" as="geometry"/>
