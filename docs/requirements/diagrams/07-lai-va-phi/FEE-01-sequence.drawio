          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="note6" value="Phí độc lập (sao kê, đóng TK): bút toán FEE riêng —&#xa;available không đủ thì fee_charges PENDING chờ thu lại.&#xa;Biểu không có dòng: phí 0, không ghi gì;&#xa;dòng biểu amount 0 vẫn ghi vết fee_charges." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="710" y="430" width="140" height="40" as="geometry"/>
