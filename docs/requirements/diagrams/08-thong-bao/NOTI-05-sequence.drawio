            <Array as="points"><mxPoint x="770" y="230"/><mxPoint x="770" y="260"/></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="note3" value="URL trỏ đích nội bộ: từ chối.&#xa;Kiểm lại MỖI lần gửi, không chỉ lúc đăng ký&#xa;(chống DNS rebinding)" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="730" y="280" width="250" height="40" as="geometry"/>
        </mxCell>
