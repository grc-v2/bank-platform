          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m7" value="201 — secret hiển thị MỘT lần duy nhất" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;strokeColor=#999999;fontColor=#999999;exitX=0;exitY=1.0;entryX=1;entryY=0.8889;" edge="1" parent="1" source="act1" target="act2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m8" value="secret (khách tự lưu, không xem lại được)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;strokeColor=#999999;fontColor=#999999;exitX=0;exitY=1.0;entryX=0.5;entryY=0.5934;" edge="1" parent="1" source="act2" target="kh">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m9" value="trước khi gửi test: phân giải DNS lại, kiểm IP đích" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=0.5;exitY=0.6484;entryX=0.5;entryY=0.6813;" edge="1" parent="1" source="noti" target="noti">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="770" y="630"/><mxPoint x="770" y="660"/></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="m10" value="gửi sự kiện thử webhook.test ký HMAC-SHA256" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;exitX=0.5;exitY=0.7253;entryX=0;entryY=0.0;" edge="1" parent="1" source="noti" target="act3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m11" value="2xx — endpoint hoạt động" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;strokeColor=#999999;fontColor=#999999;exitX=0;exitY=1.0;entryX=0.5;entryY=0.7802;" edge="1" parent="1" source="act3" target="noti">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m12" value="cập nhật last_status/last_checked_at" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=0.5;exitY=0.8352;entryX=0;entryY=0.0;" edge="1" parent="1" source="noti" target="act4">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="note13" value="Payload luôn ký HMAC-SHA256 bằng secret của endpoint.&#xa;Fail liên tục quá ngưỡng: tự tắt (active = FALSE)&#xa;+ báo khách qua kênh khác" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="730" y="830" width="250" height="40" as="geometry"/>
        </mxCell>
      </root>
