          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m15" value="201 — kênh CHƯA xác minh; đặt is_primary chỉ sau CUST-05 (BR-CUST-03-2)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;strokeColor=#999999;fontColor=#999999;exitX=0;exitY=1.0;entryX=1;entryY=0.8438;" edge="1" parent="1" source="act5" target="act6">
