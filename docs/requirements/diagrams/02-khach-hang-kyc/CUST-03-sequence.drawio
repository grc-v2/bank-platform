        <mxCell id="m1" value="chuyển tiếp (kèm user_id đang đăng nhập)" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.1064;entryX=0;entryY=0.0;" edge="1" parent="1" source="act3" target="act2">
