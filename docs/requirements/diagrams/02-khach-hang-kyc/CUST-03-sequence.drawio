        </mxCell>
        <mxCell id="m5" value="đóng dòng hiện hành cùng loại: valid_to = ngày hiệu lực; INSERT dòng mới (valid_to = NULL) + audit — một transaction" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.5676;entryX=0;entryY=0.0;" edge="1" parent="1" source="act2" target="act1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m6" value="commit OK (uq_address_current: mỗi loại một dòng hiệu lực)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;strokeColor=#999999;fontColor=#999999;exitX=0;exitY=1.0;entryX=1;entryY=0.7027;" edge="1" parent="1" source="act1" target="act2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="note7" value="BR-CUST-03-1: không UPDATE đè giá trị địa chỉ —&#xa;chỉ đóng dòng + thêm dòng, giữ lịch sử hiệu lực&#xa;để sao kê kỳ cũ in đúng địa chỉ tại kỳ đó" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="710" y="470" width="140" height="40" as="geometry"/>
        </mxCell>
