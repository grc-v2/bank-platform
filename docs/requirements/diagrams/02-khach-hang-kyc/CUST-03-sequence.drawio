        <mxCell id="m0" value="PUT /customers/{id}/addresses (loại, địa chỉ mới, ngày hiệu lực)" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=0.5;exitY=0.0882;entryX=0;entryY=0.0;" edge="1" parent="1" source="kh" target="act3">
