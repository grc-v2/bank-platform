        <mxCell id="note4" value="Sai chủ hồ sơ → 403;&#xa;CIF CLOSED → từ chối" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
