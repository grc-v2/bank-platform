        </mxCell>
        <mxCell id="note6" value="Maker–checker: người duyệt ≠ người nộp,&#xa;decided_by bắt buộc (BR-CUST-07-1);&#xa;TỪ CHỐI: reject_reason bắt buộc, CIF về DRAFT" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="330" y="430" width="160" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="m7" value="một transaction: APPROVED + decided_by + expires_at theo niên hạn mức; kyc_level = mức duyệt; PENDING_KYC → ACTIVE; ghi outbox" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.3056;entryX=0;entryY=0.0;" edge="1" parent="1" source="act3" target="act2">
