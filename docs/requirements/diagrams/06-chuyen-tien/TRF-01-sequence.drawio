          </mxGeometry>
        </mxCell>
        <mxCell id="m11" value="MỘT transaction: transfers PENDING → bút toán 3 dòng (Nợ nguồn amount+phí / Có đích / Có GL 4010 phí) → trừ transfer_limit_usage → fee_charges → COMPLETED + journal_entry_id → outbox" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.5789;entryX=0;entryY=0.0;" edge="1" parent="1" source="act5" target="act4">
