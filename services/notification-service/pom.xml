<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.bankplatform</groupId>
    <artifactId>bank-platform</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>notification-service</artifactId>
  <name>bank-platform :: notification-service</name>
  <description>Nghe event và gửi thông báo qua Telegram/Email/Webhook.</description>

  <dependencies>
    <dependency>
      <groupId>io.bankplatform</groupId>
      <artifactId>bank-common</artifactId>
    </dependency>

    <!-- Bộ nền: mọi service nghiệp vụ đều có đúng bốn starter này -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
    </dependency>

    <!--
      CỐ Ý KHÔNG có spring-boot-starter-data-redis: ServiceInfoApiTest assert
      dependencyNames(data).doesNotContain("redis"). Thêm starter này vào là
      DataRedisHealthIndicator xuất hiện và test đỏ ngay.
    -->

    <!--
      Flyway giữ lại dù spring.flyway.enabled=false. Bỏ đi thì khối
      spring.flyway.* trong application.yml (kèm lời giải thích vì sao tắt và
      điều kiện bật lại) trở thành property không ai đọc — âm thầm xoá một
      quyết định đã ghi tài liệu.
      spring-boot-flyway là jar riêng của Boot 4.x chứa FlywayConfigurationCustomizer;
      thiếu nó là NoClassDefFoundError lúc Spring soi @Bean.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-flyway</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!--
      Boot 4 tách TestRestTemplate và @AutoConfigureTestRestTemplate sang jar
      riêng spring-boot-resttestclient — starter-test KHÔNG chứa chúng.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-resttestclient</artifactId>
      <scope>test</scope>
    </dependency>
    <!--
      BẮT BUỘC đi kèm spring-boot-resttestclient, dù không dòng test nào import
      nó. Đây là họ lỗi Boot-4-split quen thuộc của repo này:
      TestRestTemplateTestAutoConfiguration.testRestTemplate() nhận tham số
      ObjectProvider<org.springframework.boot.restclient.RestTemplateBuilder>,
      mà RestTemplateBuilder.class CHỈ nằm trong jar spring-boot-restclient
      (đã kiểm bằng javap + unzip trên cả hai jar 4.1.0). Thiếu nó thì Spring
      ném NoClassDefFoundError lúc soi @ConditionalOnMissingBean — mọi test
      full-context chết khi dựng context, KHÔNG phải lỗi assertion nên thông
      báo rất khó lần. Thư viện test cũ của platform-libs khai đủ cả hai jar.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-restclient</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
