<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.javalibs</groupId>
    <artifactId>javalibs-cache</artifactId>
    <version>2.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>javalibs-cache-spring-boot-autoconfigure</artifactId>
  <packaging>jar</packaging>

  <name>javalibs :: cache :: spring-boot-autoconfigure</name>
  <description>
    Auto-configuration choosing a CacheManager: Redis (when a RedisConnectionFactory
    is available) with JSON serialization and per-cache TTLs, otherwise Caffeine.
    Active only when the application enables caching with @EnableCaching.
  </description>

  <dependencies>
    <dependency>
      <groupId>io.javalibs</groupId>
      <artifactId>javalibs-cache-spring</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-autoconfigure</artifactId>
    </dependency>
    <!--
      Boot 4 split CacheAutoConfiguration out of spring-boot-autoconfigure into its own
      artifact, moving the package to org.springframework.boot.cache.autoconfigure.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-cache</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.springframework.data</groupId>
      <artifactId>spring-data-redis</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>com.github.ben-manes.caffeine</groupId>
      <artifactId>caffeine</artifactId>
      <optional>true</optional>
    </dependency>
    <!--
      Jackson 3: jackson-databind moved to groupId tools.jackson.core. The former
      jackson-datatype-jsr310 module was merged into jackson-databind itself.
    -->
    <dependency>
      <groupId>tools.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-configuration-processor</artifactId>
      <optional>true</optional>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
