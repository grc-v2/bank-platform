<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.javalibs</groupId>
    <artifactId>javalibs-datahub</artifactId>
    <version>2.0.0-SNAPSHOT</version>
    <relativePath>..</relativePath>
  </parent>

  <artifactId>javalibs-datahub-spring-boot-autoconfigure</artifactId>

  <name>javalibs :: datahub :: spring-boot-autoconfigure</name>
  <description>
    Spring Boot auto-configuration for the datahub module: registers an EventPublisher
    (Kafka when available, logging fallback otherwise) and a pre-configured, retrying
    RestClient.Builder driven by javalibs.datahub.* properties.
  </description>

  <dependencies>
    <dependency>
      <groupId>io.javalibs</groupId>
      <artifactId>javalibs-datahub-spring</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-autoconfigure</artifactId>
    </dependency>
    <!--
      Boot 4 split DataSourceAutoConfiguration/DataSourceTransactionManagerAutoConfiguration
      out of spring-boot-autoconfigure into their own artifact, moving the package to
      org.springframework.boot.jdbc.autoconfigure. Referenced directly (after/before) by
      DatahubIdempotencyAutoConfiguration and DatahubOutboxAutoConfiguration.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-jdbc</artifactId>
      <optional>true</optional>
    </dependency>
    <!--
      Same split for KafkaAutoConfiguration, moved to org.springframework.boot.kafka.autoconfigure.
      Referenced directly (after) by DatahubKafkaAutoConfiguration.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-kafka</artifactId>
      <optional>true</optional>
    </dependency>

    <!-- Optional integrations: auto-configurations back off when these are absent -->
    <dependency>
      <groupId>org.springframework.kafka</groupId>
      <artifactId>spring-kafka</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-web</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-jdbc</artifactId>
      <optional>true</optional>
    </dependency>
    <!-- Jackson 3: jackson-databind moved to groupId tools.jackson.core. -->
    <dependency>
      <groupId>tools.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-configuration-processor</artifactId>
      <optional>true</optional>
    </dependency>

    <!-- Test -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>test</scope>
    </dependency>
    <!--
      Test-only: brings Boot's own JPA/Hibernate auto-configuration class onto the classpath so
      AutoConfigurationOrderingReferencesTest can reflectively verify that the afterName string
      on DatahubOutboxAutoConfiguration still resolves. Not a compile-scope dependency of this
      module (JPA is optional on the classpath — see the class Javadoc) — this is purely to
      catch a relocated Boot class before it silently breaks an ordering constraint in
      production, the way bậc 7 found happen in javalibs-security.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-hibernate</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
