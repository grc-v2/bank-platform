<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.javalibs</groupId>
    <artifactId>javalibs-root</artifactId>
    <version>2.0.0-SNAPSHOT</version>
    <relativePath>..</relativePath>
  </parent>

  <artifactId>javalibs-test</artifactId>
  <packaging>jar</packaging>

  <name>javalibs :: test</name>
  <description>
    Shared test support: base integration-test classes with a pre-configured
    Testcontainers PostgreSQL database, test data factories and JSON assertions.
    Client services declare this artifact with scope=test only.
  </description>

  <!--
    Dependencies are COMPILE scope on purpose: consumers add this whole artifact
    with <scope>test</scope>, which pulls everything below into their test classpath.
  -->
  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-testcontainers</artifactId>
    </dependency>
    <!--
      Boot 4 no longer auto-configures TestRestTemplate for @SpringBootTest; BaseIntegrationTest
      needs @AutoConfigureTestRestTemplate (org.springframework.boot.resttestclient.autoconfigure)
      to keep providing it to subclasses. Compile scope for the same reason as every other
      dependency here — see the class comment above.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-resttestclient</artifactId>
    </dependency>
    <!--
      TestRestTemplateTestAutoConfiguration (registered by @AutoConfigureTestRestTemplate above)
      needs RestTemplateBuilder on the classpath at context-startup time, or bean-type deduction
      throws NoClassDefFoundError. Not pulled in transitively by spring-boot-resttestclient.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-restclient</artifactId>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
    </dependency>
    <!--
      Jackson 3: jackson-databind moved to groupId tools.jackson.core. The former
      jackson-datatype-jsr310 module was merged into jackson-databind itself.
    -->
    <dependency>
      <groupId>tools.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
  </dependencies>
</project>
